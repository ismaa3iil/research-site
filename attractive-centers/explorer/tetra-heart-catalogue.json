{
  "date": "2026-10-17",
  "scope": "Four points in R^3; globally attractive rational analytic maps for L>0, continuous finite-law extension at total collapse",
  "status": "Conservative sufficient domains, proved in REVIEW_AND_PROVED_EXTENSIONS.md; not claimed sharp or boundary maps",
  "basis_order": ["U1", "K1", "K2", "V2", "V3"],
